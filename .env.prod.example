# Variáveis de PRODUÇÃO — usado por docker-compose.prod.yml.
# Copie para .env.prod e preencha com valores reais antes do deploy na VPS.
# NUNCA versione o .env.prod real (já está no .gitignore, mesma regra do .env).

# Domínios reais (DNS já apontado para a VPS antes de subir o Nginx)
APP_DOMAIN=app.seudominio.com.br
API_DOMAIN=api.seudominio.com.br

# PostgreSQL + PostGIS — troque usuário/senha, nunca reutilize os do .env de dev
POSTGRES_USER=datapoli_user
POSTGRES_PASSWORD=troque_por_uma_senha_forte_unica
POSTGRES_DB=datapoli_db

# Autenticação JWT — gere um valor próprio: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque_por_um_valor_aleatorio_proprio
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Usuário administrador criado automaticamente no startup, se ainda não existir
ADMIN_EMAIL=operador@campanha.com.br
ADMIN_PASSWORD=troque_esta_senha
ADMIN_TENANT_ID=11111111-2222-3333-4444-555555555555
