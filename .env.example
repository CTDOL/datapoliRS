# Configurações do PostgreSQL + PostGIS
POSTGRES_USER=datapoli_user
POSTGRES_PASSWORD=datapoli_pass
POSTGRES_DB=datapoli_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# URLs de Conexão com o Banco
DATABASE_URL=postgresql://datapoli_user:datapoli_pass@localhost:5432/datapoli_db
DATABASE_URL_DOCKER=postgresql://datapoli_user:datapoli_pass@postgres:5432/datapoli_db

# Configurações do Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
REDIS_URL_DOCKER=redis://redis:6379/0

# Configuração da Aplicação FastAPI
PORT=8000
PYTHONUNBUFFERED=1
ENVIRONMENT=development

# Origens permitidas para CORS (separadas por vírgula), ex: URL do frontend na Netlify
ALLOWED_ORIGINS=http://localhost:3000
